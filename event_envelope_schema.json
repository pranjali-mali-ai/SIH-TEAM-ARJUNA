{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://example.com/schemas/event_envelope.json",
  "title": "Universal Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "action": { "type": "string" },
    "source": { "type": "string" },
    "source_type": { "type": "string" },
    "schema_version": { "type": "string" },
    "status": { "type": "string", "enum": ["queued","in_progress","success","failed"] },
    "raw_location": { "type": ["string", "null"] },
    "normalized_location": { "type": ["string", "null"] },
    "trace_id": { "type": ["string", "null"] },
    "payload": { "$ref": "./student2_schema.json" }
  },
  "required": ["event_id","created_at","action","source","schema_version","payload"]
}
